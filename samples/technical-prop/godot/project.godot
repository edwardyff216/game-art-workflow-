config_version=5

[application]
config/name="Game Art Workflow — Technical Validation Only"
run/main_scene="res://validation.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=800
window/size/viewport_height=600
window/size/window_width_override=800
window/size/window_height_override=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.18, 0.18, 0.18, 1)
